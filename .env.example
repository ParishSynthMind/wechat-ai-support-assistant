# Copy to .env (git-ignored) or export these. No values here are real.
WECHAT_APPID=wx0000000000000000
# Secrets: set them here, or leave them out and put them in the macOS Keychain
# (items wechat-test-appsecret, wechat-callback-token, wechat-encoding-aes-key, anthropic-api-key).
WECHAT_APPSECRET=
WECHAT_TOKEN=
# WECHAT_AES_KEY=          # only for safe/compatible mode: the 43-character EncodingAESKey
ANTHROPIC_API_KEY=
# AI_PROVIDER=gemini        # and GEMINI_API_KEY=
